<h2>Card due soon: {{cardTitle}}</h2>
<p>Hi {{name}},</p>
<p>A card you're assigned to is due in <strong>{{hoursUntilDue}} hours</strong>:</p>
<table style="width:100%; border-collapse:collapse; margin:16px 0; background:#f5f5f5; border-radius:12px; overflow:hidden;">
  <tr><td style="padding:12px 16px; font-size:13px; color:#78716c;">Card</td><td style="padding:12px 16px; font-weight:600;">{{cardTitle}}</td></tr>
  <tr><td style="padding:12px 16px; font-size:13px; color:#78716c;">Board</td><td style="padding:12px 16px;">{{boardName}}</td></tr>
  <tr><td style="padding:12px 16px; font-size:13px; color:#78716c;">Due</td><td style="padding:12px 16px; color:#dc2626; font-weight:500;">{{dueDate}}</td></tr>
  <tr><td style="padding:12px 16px; font-size:13px; color:#78716c;">Priority</td><td style="padding:12px 16px;">{{priority}}</td></tr>
</table>
<a href="{{cardUrl}}" class="btn">View Card</a>

