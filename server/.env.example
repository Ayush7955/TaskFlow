# ---------- App ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=p16_taskmanager
DB_USER=root
DB_PASSWORD=changeme
DB_POOL_MAX=10
DB_LOGGING=false

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_me_access_64_chars_min_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_64_chars_min_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---------- Uploads ----------
UPLOAD_PROVIDER=cloudinary
MAX_UPLOAD_MB=10
ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,application/zip
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ---------- Mail ----------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@taskflow.dev>"

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# ---------- Rate limiting ----------
RL_GLOBAL_WINDOW_MS=900000
RL_GLOBAL_MAX=300
RL_AUTH_WINDOW_MS=900000
RL_AUTH_MAX=10
RL_UPLOAD_WINDOW_MS=60000
RL_UPLOAD_MAX=20

# ---------- Jobs ----------
CRON_DUE_REMINDER=*/15 * * * *
CRON_OVERDUE_SCAN=0 * * * *
DUE_REMINDER_HOURS_BEFORE=24

